{
  "name": "wechat-official-account-mcp",
  "version": "2.2.1",
  "type": "module",
  "description": "微信公众号 MCP 服务 - 为 AI 应用提供完整的微信公众号 API 集成（14 个读写分离工具，覆盖 101 个动作）",
  "keywords": [
    "wechat",
    "mcp",
    "ai",
    "api",
    "typescript",
    "official-account"
  ],
  "author": "xwang152-jack <xwang152@163.com>",
  "license": "MIT",
  "bin": {
    "wechat-mcp": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xwang152-jack/wechat-official-account-mcp.git"
  },
  "homepage": "https://github.com/xwang152-jack/wechat-official-account-mcp#readme",
  "bugs": {
    "url": "https://github.com/xwang152-jack/wechat-official-account-mcp/issues"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "build:prod": "npm run clean && tsc --project tsconfig.prod.json",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build:prod",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "npm run build:prod && node test-tools.js",
    "verify": "npm run build && node scripts/verify-upgrade.mjs && node scripts/verify-mcp-protocol.mjs && node scripts/verify-api-normalization.mjs",
    "clean": "rm -rf dist",
    "pack:dry": "npm pack --dry-run",
    "start": "node dist/src/cli.js",
    "postbuild": "chmod +x dist/src/cli.js",
    "build:full": "./scripts/build.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/crypto-js": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.3",
    "@types/sqlite3": "^3.1.11",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
